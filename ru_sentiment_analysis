P_WORDS) -> list:\n","    \"\"\"Токенизация: нижний регистр, только буквы, без стоп-слов, длина > 2.\"\"\"\n","    text = text.lower()\n","    text = re.sub(r'[^а-яёa-z\\s]', ' ', text)\n","    tokens = word_tokenize(text, language='russian')\n","    return [t for t in tokens if t not in stopwords_set and len(t) > 2]\n","\n","print('Предобработка текстов...')\n","df_full['tokens'] = df_full['text'].apply(preprocess_text)\n","df_full['clean_text'] = df_full['tokens'].str.join(' ')\n","print(f'Готово. Пример: {df_full[\"tokens\"].iloc[0][:10]}')"]},{"cell_type":"code","execution_count":18,"id":"ce0f310b","metadata":{"execution":{"iopub.execute_input":"2026-05-19T19:57:56.794106Z","iopub.status.busy":"2026-05-19T19:57:56.793328Z","iopub.status.idle":"2026-05-19T19:59:38.814739Z","shell.execute_reply":"2026-05-19T19:59:38.813597Z"},"papermill":{"duration":102.086478,"end_time":"2026-05-19T19:59:38.862414+00:00","exception":false,"start_time":"2026-05-19T19:57:56.775936+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 2400x720 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Облака слов для каждого класса \n","fig, axes = plt.subplots(1, 3, figsize=(20, 6))\n","\n","for ax, cls in zip(axes, CLASS_NAMES):\n","    corpus = ' '.join(df_full[df_full['label_name'] == cls]['clean_text'])\n","    cmap = {'Neutral': 'Greys', 'Positive': 'Greens', 'Negative': 'Reds'}[cls]\n","    wc = WordCloud(width=600, height=350, background_color='white',\n","                   colormap=cmap, max_words=100).generate(corpus)\n","    ax.imshow(wc, interpolation='bilinear')\n","    ax.axis('off')\n","    ax.set_title(cls, fontsize=13, fontweight='bold', color=COLORS[cls])\n","\n","plt.suptitle('Облака слов по классам тональности', fontsize=15, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":19,"id":"fd5b8d74","metadata":{"execution":{"iopub.execute_input":"2026-05-19T19:59:38.926173Z","iopub.status.busy":"2026-05-19T19:59:38.925347Z","iopub.status.idle":"2026-05-19T19:59:43.534751Z","shell.execute_reply":"2026-05-19T19:59:43.533875Z"},"papermill":{"duration":4.645621,"end_time":"2026-05-19T19:59:43.538703+00:00","exception":false,"start_time":"2026-05-19T19:59:38.893082+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 2400x840 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Топ-20 слов для каждого класса \n","fig, axes = plt.subplots(1, 3, figsize=(20, 7))\n","\n","for ax, cls in zip(axes, CLASS_NAMES):\n","    tokens_flat = [t for tokens in df_full[df_full['label_name'] == cls]['tokens']\n","                   for t in tokens]\n","    top20 = Counter(tokens_flat).most_common(20)\n","    words, counts = zip(*top20)\n","\n","    bars = ax.barh(range(len(words)), counts, color=COLORS[cls], alpha=0.8)\n","    ax.set_yticks(range(len(words)))\n","    ax.set_yticklabels(words)\n","    ax.invert_yaxis()\n","    ax.set_title(f'Топ-20: {cls}', fontweight='bold')\n","    ax.set_xlabel('Частота')\n","    for bar, cnt in zip(bars, counts):\n","        ax.text(cnt + 0.5, bar.get_y() + bar.get_height()/2,\n","                str(cnt), va='center', fontsize=8)\n","\n","plt.suptitle('Наиболее частые слова по классам', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":20,"id":"602d472b","metadata":{"execution":{"iopub.execute_input":"2026-05-19T19:59:43.607798Z","iopub.status.busy":"2026-05-19T19:59:43.607464Z","iopub.status.idle":"2026-05-19T19:59:43.950545Z","shell.execute_reply":"2026-05-19T19:59:43.949489Z"},"papermill":{"duration":0.379867,"end_time":"2026-05-19T19:59:43.952392+00:00","exception":false,"start_time":"2026-05-19T19:59:43.572525+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Neutral: встречается в 19701 текстах (39.4%)\n","Positive: встречается в 48876 текстах (51.8%)\n","Negative: встречается в 16399 текстах (30.3%)\n"]}],"source":["# Смотрим насколько равномерно \"очень\" распределено по классам\n","word = 'очень'\n","for cls in CLASS_NAMES:\n","    subset = df_full[df_full['label_name'] == cls]\n","    count = sum(1 for tokens in subset['tokens'] if word in tokens)\n","    pct = count / len(subset) * 100\n","    print(f'{cls}: встречается в {count} текстах ({pct:.1f}%)')"]},{"cell_type":"markdown","id":"692aad62","metadata":{"papermill":{"duration":0.037278,"end_time":"2026-05-19T19:59:44.024484+00:00","exception":false,"start_time":"2026-05-19T19:59:43.987206+00:00","status":"completed"},"tags":[]},"source":["## Тематическое моделирование (LDA)"]},{"cell_type":"markdown","id":"ee44ea03","metadata":{"papermill":{"duration":0.030704,"end_time":"2026-05-19T19:59:44.088611+00:00","exception":false,"start_time":"2026-05-19T19:59:44.057907+00:00","status":"completed"},"tags":[]},"source":["### Обоснование выбора алгоритма тематического моделирования\n","\n","В качестве алгоритма тематического моделирования выбран LDA (Latent Dirichlet Allocation).\n","\n","В процессе выбора были рассмотрены следующие альтернативы:\n","\n","**BERTopic** - был опробован на данном датасете. Несмотря на теоретические \n","преимущества (учёт семантического контекста через BERT-эмбеддинги, автоматическое \n","определение числа тем), на практике показал неудовлетворительный результат: \n","алгоритм кластеризации HDBSCAN объединил 180k из 210k текстов в одну тему, \n","что делает результат непригодным для анализа. Причина - высокая плотность \n","эмбеддингов в одной области пространства при использовании лёгкой модели \n","rubert-tiny, что типично для коротких однородных текстов (отзывы).\n","\n","**NMF (Non-negative Matrix Factorization)** - схож с LDA по принципу работы \n","(bag-of-words), даёт сопоставимое качество тем, но лишён вероятностной \n","интерпретации и хуже поддерживается инструментами оценки (нет стандартной \n","метрики coherence) и визуализации (нет pyLDAvis).\n","\n","**LSA (Latent Semantic Analysis)** - быстрый алгоритм на основе SVD, однако \n","темы значительно труднее интерпретировать, так как компоненты могут содержать \n","отрицательные веса слов, и отсутствует вероятностная интерпретация документов.\n","\n","**LDA выбран по следующим причинам:**\n","- Полный контроль над числом тем через подбор по метрике Coherence Score (c_v)\n","- На корпусе коротких отзывов bag-of-words представление достаточно: \n","  тематика определяется конкретными словами (врач, отель, ресторан), \n","  а не тонким семантическим контекстом\n","- Результаты воспроизводимы и интерпретируемы\n","- Реализация Gensim поддерживает многопоточность (параметр workers)\n","\n","Число тем подбирается автоматически через перебор от 5 до 13 \n","и выбор максимума Coherence Score (c_v) - метрики, которая \n","измеряет семантическую согласованность слов внутри темы и \n","лучше всего коррелирует с экспертной оценкой качества тем."]},{"cell_type":"markdown","id":"c9133f7c","metadata":{"papermill":{"duration":0.029222,"end_time":"2026-05-19T19:59:44.147244+00:00","exception":false,"start_time":"2026-05-19T19:59:44.118022+00:00","status":"completed"},"tags":[]},"source":["Анализ частот показал, что слово «очень» встречается во всех классах тональности с высокой частотой (39–52% документов). Поскольку данное слово является эмоциональным усилителем, а не индикатором темы, оно было добавлено в расширенный список стоп-слов исключительно для задачи тематического моделирования (LDA). Аналогичная картина для слов «просто», «время», «день», LDA такие слова являются шумом, они не несут информации о теме, но размывают тематические кластеры. Это позволяет сделать темы более интерпретируемыми и снизить влияние шумовых токенов.\n","\n","Важно отметить, что расширенная фильтрация стоп-слов применяется только для тематического моделирования (LDA). Для моделей классификации тональности (TF-IDF + Logistic Regression, BERT) данные слова сохраняются, поскольку могут содержать полезную информацию о выраженности эмоций и влиять на качество классификации."]},{"cell_type":"code","execution_count":21,"id":"a51916e6","metadata":{"execution":{"iopub.execute_input":"2026-05-19T19:59:44.20972Z","iopub.status.busy":"2026-05-19T19:59:44.209337Z","iopub.status.idle":"2026-05-19T20:01:13.141374Z","shell.execute_reply":"2026-05-19T20:01:13.140446Z"},"papermill":{"duration":89.000416,"end_time":"2026-05-19T20:01:13.177374+00:00","exception":false,"start_time":"2026-05-19T19:59:44.176958+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Готовим токены для LDA...\n","Пример токенов для LDA: ['спросил', 'посланник', 'аллаха', 'порицаешь', 'слушания', 'ответил', 'порицаю', 'передай', 'открывали', 'свои']\n"]}],"source":["LDA_EXTRA_STOP_WORDS = {\n","    'очень', 'просто', 'нам', 'всем', 'вообще',  # частые во всех классах\n","    'года', 'году', 'день', 'время', 'хотя',     # тематически нейтральные\n","}\n","\n","LDA_STOP_WORDS = STOP_WORDS | LDA_EXTRA_STOP_WORDS\n","\n","print('Готовим токены для LDA...')\n","df_full['tokens_lda'] = df_full['text'].apply(\n","    lambda x: preprocess_text(x, LDA_STOP_WORDS)\n",")\n","print(f'Пример токенов для LDA: {df_full[\"tokens_lda\"].iloc[0][:10]}')"]},{"cell_type":"code","execution_count":22,"id":"8a9dd100","metadata":{"execution":{"iopub.execute_input":"2026-05-19T20:01:13.2478Z","iopub.status.busy":"2026-05-19T20:01:13.247089Z","iopub.status.idle":"2026-05-19T20:01:41.078452Z","shell.execute_reply":"2026-05-19T20:01:41.077433Z"},"papermill":{"duration":27.869102,"end_time":"2026-05-19T20:01:41.080319+00:00","exception":false,"start_time":"2026-05-19T20:01:13.211217+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Размер словаря: 75721 токенов\n","Документов: 198443\n"]}],"source":["# Корпус для LDA \n","corpus_tokens = df_full['tokens_lda'].tolist()\n","\n","# Фильтруем словарь:\n","# no_below=10 - убираем слова встречающиеся менее чем в 10 документах (опечатки, редкие слова)\n","# no_above=0.85 - убираем слова встречающиеся более чем в 85% документов (не несут тематики)\n","id2word = corpora.Dictionary(corpus_tokens)\n","id2word.filter_extremes(no_below=10, no_above=0.85)\n","print(f'Размер словаря: {len(id2word)} токенов')\n","\n","# Bag-of-words представление каждого документа\n","bow_corpus = [id2word.doc2bow(doc) for doc in corpus_tokens]\n","print(f'Документов: {len(bow_corpus)}')"]},{"cell_type":"code","execution_count":23,"id":"7ac1271e","metadata":{"execution":{"iopub.execute_input":"2026-05-19T20:01:41.150723Z","iopub.status.busy":"2026-05-19T20:01:41.149798Z","iopub.status.idle":"2026-05-19T20:53:38.717047Z","shell.execute_reply":"2026-05-19T20:53:38.716196Z"},"papermill":{"duration":3117.627634,"end_time":"2026-05-19T20:53:38.742703+00:00","exception":false,"start_time":"2026-05-19T20:01:41.115069+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Подбор числа тем...\n"]},{"name":"stderr","output_type":"stream","text":["WARNING:gensim.models.ldamodel:updated prior is not positive\n"]},{"name":"stdout","output_type":"stream","text":["  n_topics= 5  coherence=0.6784\n","  n_topics= 6  coherence=0.6939\n","  n_topics= 7  coherence=0.7091\n","  n_topics= 8  coherence=0.6834\n","  n_topics= 9  coherence=0.6488\n","  n_topics=10  coherence=0.7050\n","  n_topics=11  coherence=0.6577\n","  n_topics=12  coherence=0.6352\n","\n","✅ Лучшее число тем: 7\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1080x480 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Подбор числа тем через Coherence Score \n","# Перебираем диапазон от 5 до 13 тем и считаем Coherence Score (c_v)\n","# c_v измеряет семантическую согласованность слов внутри темы -\n","# чем выше, тем более связанные слова объединяются в одну тему\n","print('Подбор числа тем...')\n","\n","topic_range = range(5, 13)\n","coherence_scores = []\n","\n","for n_topics in topic_range:\n","    lda_tmp = LdaModel(\n","        corpus=bow_corpus, id2word=id2word,\n","        num_topics=n_topics, random_state=SEED,\n","        passes=5, alpha='auto', eta='auto',\n","    )\n","    cm = CoherenceModel(model=lda_tmp, texts=corpus_tokens,\n","                        dictionary=id2word, coherence='c_v')\n","    score = cm.get_coherence()\n","    coherence_scores.append(score)\n","    print(f'  n_topics={n_topics:2d}  coherence={score:.4f}')\n","\n","best_n = list(topic_range)[np.argmax(coherence_scores)]\n","print(f'\\n✅ Лучшее число тем: {best_n}')\n","\n","plt.figure(figsize=(9, 4))\n","plt.plot(list(topic_range), coherence_scores, 'o-', color='steelblue', linewidth=2)\n","plt.axvline(x=best_n, color='red', linestyle='--', label=f'Оптимум: {best_n} тем')\n","plt.scatter([best_n], [max(coherence_scores)], color='red', s=120, zorder=5)\n","plt.xlabel('Число тем')\n","plt.ylabel('Coherence Score (c_v)')\n","plt.title('Подбор числа тем для LDA')\n","plt.legend()\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":24,"id":"48e325f4","metadata":{"execution":{"iopub.execute_input":"2026-05-19T20:53:38.809303Z","iopub.status.busy":"2026-05-19T20:53:38.808804Z","iopub.status.idle":"2026-05-19T21:16:23.179592Z","shell.execute_reply":"2026-05-19T21:16:23.178476Z"},"papermill":{"duration":1364.436557,"end_time":"2026-05-19T21:16:23.211241+00:00","exception":false,"start_time":"2026-05-19T20:53:38.774684+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Coherence Score: 0.7026\n","Perplexity:      -9.16\n","\n","=== Темы ===\n","Тема 1: 0.007*\"врач\" + 0.004*\"врача\" + 0.004*\"деньги\" + 0.004*\"ребенка\" + 0.004*\"прием\" + 0.003*\"сказали\" + 0.003*\"сказала\" + 0.003*\"узи\" + 0.003*\"туда\" + 0.003*\"пришла\"\n","Тема 2: 0.007*\"тенге\" + 0.004*\"казахстана\" + 0.004*\"млрд\" + 0.003*