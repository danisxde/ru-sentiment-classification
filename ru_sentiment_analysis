                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           text label_name\n","55430     08 ноября 2016, 20:18   forbes.kz   Костанай в этом году стал автомобильной столицей Казахстана. 60% валового автомобильного производства страны приходится на долю областного центра, передает корреспондент  .   «Костанайское предприятие первое перешло на мелкоузловое производство. По некоторым видам коммерческой техники рост локализации (использование автокомпонентов отечественного производства. Прим.ред.) дошел до 50 процентов, по легковым автомобилям до 35 процентов, и это не предел. В стране с момента ГПФИИР было произведено почти 630 тысяч автомобилей казахстанского производства на сумму 550 млрд тенге, создано более 17 тысяч рабочих мест в смежных отраслях. Мы добились того, что доля авто казахстанского производства сегодня уже составляет более 33 процентов», — сообщил глава Ассоциации казахстанского автобизнеса Андрей Лаврентьев во время визита первого вице-премьера Аскара Мамина в Костанайскую область.   Говоря в целом о состоянии казахстанского автопрома, Лаврентьев отметил, что рынок постепенно справляется с последствиями экономического кризиса и в августе удалось достигнуть уровня развития прошлых лет. Но подчеркнул, что населению нужен бюджетный автомобиль, такой как, например, узбекский Ravon (усовершенствованная Nexia). Его стоимость составляет в среднем 2 млн 200 тысяч тенге и такой цены удалось достичь благодаря высокой локализации автокомпонентов   — 90 процентов.   «Чтобы перейти к локализации, нам нужно рассмотреть два вопроса. Первый – это стимулирование внутреннего рынка, это поддержка по программе лизинга, по программе льготного кредитования, которой воспользовались более 40 процентов граждан, купивших в 2016 году автомобили. Второй вопрос – это обеспечение экспортного потенциала. Здесь наш главный партнер – Российская федерация. Также готовность делать серьезные вложения в казахстанский автопром в рамках совместного предприятия выразили китайцы с автомобильным брендом Jac», — добавил Лаврентьев.   Первый заместитель премьер-министра Аскар Мамин похвалил главу Ассоциации казахстанского автобизнеса за привлечение инвестиций в регион и пообещал под