e,"start_time":"2026-05-19T21:16:23.241841+00:00","status":"completed"},"tags":[]},"source":["## Визуализация тем"]},{"cell_type":"code","execution_count":25,"id":"d4db375f","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:16:23.33278Z","iopub.status.busy":"2026-05-19T21:16:23.332349Z","iopub.status.idle":"2026-05-19T21:16:25.157133Z","shell.execute_reply":"2026-05-19T21:16:25.15623Z"},"papermill":{"duration":1.881578,"end_time":"2026-05-19T21:16:25.183944+00:00","exception":false,"start_time":"2026-05-19T21:16:23.302366+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 2160x1800 with 9 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Облака слов для каждой темы \n","ncols = 3\n","nrows = (N_TOPICS + ncols - 1) // ncols\n","fig, axes = plt.subplots(nrows, ncols, figsize=(18, 5 * nrows))\n","axes = axes.flatten()\n","\n","for i in range(N_TOPICS):\n","    topic_terms = dict(lda_model.show_topic(i, topn=40))\n","    wc = WordCloud(width=400, height=250,\n","                   background_color='white').generate_from_frequencies(topic_terms)\n","    axes[i].imshow(wc, interpolation='bilinear')\n","    axes[i].axis('off')\n","    axes[i].set_title(f'Тема {i+1}', fontweight='bold')\n","\n","for j in range(N_TOPICS, len(axes)):\n","    axes[j].axis('off')\n","\n","plt.suptitle('Облака слов по темам (LDA)', fontsize=15, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":26,"id":"116346a3","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:16:25.292873Z","iopub.status.busy":"2026-05-19T21:16:25.292115Z","iopub.status.idle":"2026-05-19T21:16:25.716468Z","shell.execute_reply":"2026-05-19T21:16:25.715776Z"},"papermill":{"duration":0.482146,"end_time":"2026-05-19T21:16:25.719935+00:00","exception":false,"start_time":"2026-05-19T21:16:25.237789+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1680x744 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Heatmap: топ-слова по темам\n","N_WORDS = 10\n","top_words_per_topic, topic_word_matrix = [], []\n","\n","for i in range(N_TOPICS):\n","    terms = lda_model.show_topic(i, topn=N_WORDS)\n","    top_words_per_topic.append([w for w, _ in terms])\n","    topic_word_matrix.append([v for _, v in terms])\n","\n","df_heatmap = pd.DataFrame(\n","    topic_word_matrix,\n","    index=[f'Тема {i+1}' for i in range(N_TOPICS)],\n","    columns=[f'Слово {j+1}' for j in range(N_WORDS)],\n",")\n","\n","fig, ax = plt.subplots(figsize=(14, max(4, N_TOPICS * 0.6 + 2)))\n","sns.heatmap(df_heatmap, annot=np.array(top_words_per_topic), fmt='',\n","            cmap='YlOrRd', linewidths=0.5, ax=ax,\n","            cbar_kws={'label': 'Вес слова в теме'})\n","ax.set_title('Топ-слова по темам LDA', fontsize=14, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":27,"id":"eb04e908","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:16:25.840899Z","iopub.status.busy":"2026-05-19T21:16:25.840259Z","iopub.status.idle":"2026-05-19T21:17:10.2761Z","shell.execute_reply":"2026-05-19T21:17:10.275348Z"},"papermill":{"duration":44.5547,"end_time":"2026-05-19T21:17:10.335218+00:00","exception":false,"start_time":"2026-05-19T21:16:25.780518+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1920x600 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Распределение доминирующих тем по классам \n","dominant_topics = []\n","for bow in bow_corpus:\n","    topic_dist = lda_model.get_document_topics(bow, minimum_probability=0)\n","    dominant_topics.append(max(topic_dist, key=lambda x: x[1])[0])\n","\n","df_full['dominant_topic']       = dominant_topics\n","df_full['dominant_topic_label'] = df_full['dominant_topic'].apply(lambda x: f'Тема {x+1}')\n","\n","fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n","\n","df_full['dominant_topic_label'].value_counts().sort_index().plot(\n","    kind='bar', ax=axes[0], color='steelblue', edgecolor='black')\n","axes[0].set_title('Распределение доминирующих тем')\n","axes[0].set_xlabel('Тема')\n","axes[0].set_ylabel('Документов')\n","axes[0].tick_params(axis='x', rotation=45)\n","\n","pivot = df_full.groupby(['dominant_topic_label', 'label_name']).size().unstack(fill_value=0)\n","pivot = pivot.reindex(columns=CLASS_NAMES)\n","pivot.plot(kind='bar', ax=axes[1],\n","           color=[COLORS[c] for c in CLASS_NAMES], edgecolor='black')\n","axes[1].set_title('Темы в разрезе тональности (3 класса)')\n","axes[1].set_xlabel('Тема')\n","axes[1].tick_params(axis='x', rotation=45)\n","axes[1].legend(title='Тональность')\n","\n","plt.suptitle('Тематическая структура корпуса', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"7423789c","metadata":{"papermill":{"duration":0.054138,"end_time":"2026-05-19T21:17:10.444626+00:00","exception":false,"start_time":"2026-05-19T21:17:10.390488+00:00","status":"completed"},"tags":[]},"source":["### Предложения по улучшению тематического моделирования\n","\n","1. Лемматизация через pymorphy2 или natasha.\n","   Сейчас токенизация не приводит слова к нормальной форме - \"врач\", \"врача\", \n","   \"врачу\" считаются разными токенами и засоряют темы. Лемматизация объединит \n","   их в одну форму, уменьшит словарь и повысит качество тем.\n","\n","2. Добавление биграмм и триграмм через gensim.Phrases.\n","   Словосочетания \"быстрая доставка\", \"плохой сервис\", \"чистый номер\" \n","   несут значительно больше смысла чем отдельные слова. \n","   Автоматическое обнаружение устойчивых сочетаний улучшит интерпретируемость тем.\n","\n","3. Раздельное тематическое моделирование по классам тональности.\n","   Обучение отдельных LDA-моделей для Positive, Negative и Neutral текстов \n","   позволит выявить класс-специфичные темы: например, что именно хвалят \n","   в позитивных отзывах и на что жалуются в негативных.\n","\n","4. Тонкая настройка гиперпараметров alpha и eta.\n","   Текущие значения alpha='auto' и eta='auto' - это эвристика Gensim. \n","   Grid search по сетке значений с оценкой через Coherence Score \n","   может дать более качественные темы.\n","\n","5. Фильтрация тематически шумных документов.\n","   Документы с равномерным распределением вероятностей по всем темам \n","   (высокая энтропия распределения) не несут чёткой тематики и могут \n","   ухудшать качество модели. Их фильтрация перед обучением потенциально \n","   улучшит coherence.\n","\n","6. Повторная попытка с BERTopic на более мощной модели эмбеддингов.\n","   Использование rubert-base-cased вместо rubert-tiny в связке \n","   с подобранными параметрами HDBSCAN (min_cluster_size=500, \n","   cluster_selection_method='leaf') может дать более качественное \n","   разбиение на темы с учётом семантического контекста.\n","\n","7. Иерархическое тематическое моделирование.\n","   BERTopic и специальные расширения LDA поддерживают построение \n","   иерархии тем: сначала крупные категории (медицина, гостиницы, \n","   транспорт), затем подтемы внутри каждой."]},{"cell_type":"markdown","id":"db3d2fc4","metadata":{"papermill":{"duration":0.054179,"end_time":"2026-05-19T21:17:10.554599+00:00","exception":false,"start_time":"2026-05-19T21:17:10.50042+00:00","status":"completed"},"tags":[]},"source":["# Часть 2. Обучение классификатора"]},{"cell_type":"markdown","id":"6e7a34ca","metadata":{"papermill":{"duration":0.05921,"end_time":"2026-05-19T21:17:10.667121+00:00","exception":false,"start_time":"2026-05-19T21:17:10.607911+00:00","status":"completed"},"tags":[]},"source":["## Разбивка данных"]},{"cell_type":"markdown","id":"873df1a2","metadata":{"papermill":{"duration":0.056027,"end_time":"2026-05-19T21:17:10.776102+00:00","exception":false,"start_time":"2026-05-19T21:17:10.720075+00:00","status":"completed"},"tags":[]},"source":["### Обоснование разбивки данных\n","\n","Данные разбиты на три части в соотношении 70% / 15% / 15%\n","(train / val / test) с помощью стратифицированного разбиения.\n","\n","Готовое разбиение от авторов датасета не использовалось по следующей \n","причине: датасет содержит только два сплита - train и validation - \n","без выделенного тестового набора. Использование validation в качестве \n","теста некорректно, так как на нём производится подбор лучшей эпохи \n","в процессе обучения (сохранение модели по максимуму val F1), \n","что приводит к утечке данных и завышению итоговых метрик.\n","\n","Поэтому данные объединены и разбиты заново через sklearn.train_test_split\n","с параметром stratify=label, что гарантирует сохранение пропорций \n","классов (Neutral / Positive / Negative) в каждом из трёх сплитов.\n","\n","Выбор соотношения 70/15/15:\n","- 70% на обучение - достаточно для fine-tuning BERT на датасете \n","  размером ~210k текстов (147k примеров в train)\n","- 15% на валидацию - используется в процессе обучения для выбора \n","  лучшей эпохи по метрике val F1 (31k примеров)\n","- 15% на тест - не участвует в обучении и подборе гиперпараметров,\n","  используется исключительно для финальной оценки качества (31k примеров)\n","\n","Фиксация random_state=42 обеспечивает воспроизводимость разбиения."]},{"cell_type":"code","execution_count":28,"id":"3b6b820d","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:17:10.886629Z","iopub.status.busy":"2026-05-19T21:17:10.885722Z","iopub.status.idle":"2026-05-19T21:17:11.305977Z","shell.execute_reply":"2026-05-19T21:17:11.305089Z"},"papermill":{"duration":0.478031,"end_time":"2026-05-19T21:17:11.307741+00:00","exception":false,"start_time":"2026-05-19T21:17:10.82971+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train: 138910 | Val: 29766 | Test: 29767\n","Train распределение: [34992 66067 37851]\n","Val   распределение: [ 7498 14157  8111]\n","Test  распределение: [ 7499 14157  8111]\n"]}],"source":["# Разбивка данных\n","# Стратифицированное разбиение 70/15/15 сохраняет пропорции\n","# всех трёх классов в каждом сплите\n","train_df, temp_df = train_test_split(df_full, test_size=0.30,\n","                                      random_state=SEED, stratify=df_full['label'])\n","# Из оставшихся 30% делаем val и test поровну\n","val_df, test_df = train_test_split(temp_df, test_size=0.50,\n","                                      random_state=SEED, stratify=temp_df['label'])\n","\n","X_train, y_train = train_df['text'].values, train_df['label'].values\n","X_val, y_val = val_df['text'].values, val_df['label'].values\n","X_test, y_test = test_df['text'].values, test_df['label'].values\n","\n","print(f'Train: {len(X_train)} | Val: {len(X_val)} | Test: {len(X_test)}')\n","print(f'Train распределение: {np.bincount(y_train)}')\n","print(f'Val   распределение: {np.bincount(y_val)}')\n","print(f'Test  распределение: {np.bincount(y_test)}')"]},{"cell_type":"markdown","id":"6b5824cc","metadata":{"papermill":{"duration":0.056285,"end_time":"2026-05-19T21:17:11.422683+00:00","exception":false,"start_time":"2026-05-19T21:17:11.366398+00:00","status":"completed"},"tags":[]},"source":["## Бейзлайн\n","TFIDF + LogisticRegression"]},{"cell_type":"code","execution_count":29,"id":"f2bd2e09","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:17:11.544718Z","iopub.status.busy":"2026-05-19T21:17:11.543922Z","iopub.status.idle":"2026-05-19T21:18:47.164273Z","shell.execute_reply":"2026-05-19T21:18:47.163588Z"},"papermill":{"duration":95.761411,"end_time":"2026-05-19T21:18:47.240805+00:00","exception":false,"start_time":"2026-05-19T21:17:11.479394+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Baseline Accuracy: 0.7566\n","Baseline F1 macro: 0.7525\n","Baseline ROC-AUC:  0.9158\n","              precision    recall  f1-score   support\n","\n","     Neutral       0.60      0.78      0.68      7499\n","    Positive       0.87      0.71      0.78     14157\n","    Negative       0.78      0.81      0.79      8111\n","\n","    accuracy                           0.76     29767\n","   macro avg       0.75      0.77      0.75     29767\n","weighted avg       0.78      0.76      0.76     29767\n","\n"]}],"source":["tfidf = TfidfVectorizer(max_features=30_000, ngram_range=(1, 2), min_df=2)\n","X_train_tfidf = tfidf.fit_transform(X_train)\n","X_val_tfidf = tfidf.transform(X_val)\n","X_test_tfidf = tfidf.transform(X_test)\n","\n","lr = LogisticRegression(C=1.0, max_iter=500,\n","                        class_weight='balanced',\n","                        multi_class='multinomial',\n","                        random_state=SEED)\n","lr.fit(X_train_tfidf, y_train)\n","\n","y_pred_lr = lr.predict(X_test_tfidf)\n","lr_probs = lr.predict_proba(X_test_tfidf)\n","\n","baseline_acc = accuracy_score(y_test, y_pred_lr)\n","baseline_f1 = f1_score(y_test, y_pred_lr, average='macro')\n","baseline_auc = roc_auc_score(y_test, lr_probs, multi_class='ovr', average='macro')\n","\n","print(f'Baseline Accuracy: {baseline_acc:.4f}')\n","print(f'Baseline F1 macro: {baseline_f1:.4f}')\n","print(f'Baseline ROC-AUC:  {baseline_auc:.4f}')\n","print(classification_report(y_test, y_pred_lr, target_names=CLASS_NAMES))"]},{"cell_type":"markdown","id":"b835d801","metadata":{"papermill":{"duration":0.056132,"end_time":"2026-05-19T21:18:47.355024+00:00","exception":false,"start_time":"2026-05-19T21:18:47.298892+00:00","status":"completed"},"tags":[]},"source":["## Dataset и DataLoader"]},{"cell_type":"code","execution_count":30,"id":"3a44b51d","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:18:47.46992Z","iopub.status.busy":"2026-05-19T21:18:47.469638Z","iopub.status.idle":"2026-05-19T21:21:06.166991Z","shell.execute_reply":"2026-05-19T21:21:06.166112Z"},"papermill":{"duration":138.813891,"end_time":"2026-05-19T21:21:06.225861+00:00","exception":false,"start_time":"2026-05-19T21:18:47.41197+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"f4985da4e94f496a8dd53e27ccd9b4e0","version_major":2,"version_minor":0},"text/plain":["config.json:   0%|          | 0.00/693 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"f30cf060e380458698de78e4996f80d8","version_major":2,"version_minor":0},"text/plain":["tokenizer_config.json:   0%|          | 0.00/401 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"532e2425577548e891bf29dafba07eb9","version_major":2,"version_minor":0},"text/plain":["vocab.txt: 0.00B [00:00, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"82ccd7af72cb4da1801ffba66ac5f3a1","version_major":2,"version_minor":0},"text/plain":["tokenizer.json: 0.00B [00:00, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"9862465570134f1e93958ced41feeaee","version_major":2,"version_minor":0},"text/plain":["special_tokens_map.json:   0%|          | 0.00/112 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Длины токенов - медиана: 110, 95-й перцентиль: 469, макс: 1026\n","Train batches: 3473 | Val batches: 745\n"]}],"source":["MODEL_NAME = 'cointegrated/rubert-tiny2'\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n","\n","# Подбор MAX_LEN по 95-му перцентилю длин токенов\n","sample_lens = [len(tokenizer.encode(t, truncation=False)) for t in X_train[:1000]]\n","print(f'Длины токенов - медиана: {np.median(sample_lens):.0f}, '\n","      f'95-й перцентиль: {np.percentile(sample_lens, 95):.0f}, '\n","      f'макс: {max(sample_lens)}')\n","\n","MAX_LEN = 512\n","BATCH_SIZE = 40\n","\n","\n","class SentimentDataset(Dataset):\n","    \"\"\"Dataset для 3-классовой классификации тональности.\n","       Токенизирует все тексты сразу при инициализации (не на лету)\n","       это ускоряет обучение за счёт отсутствия повторной токенизации на каждой эпохе\"\"\"\n","\n","    def __init__(self, texts, labels, tokenizer, max_len):\n","        # padding='max_length' - все тексты дополняются до MAX_LEN\n","        # truncation=True - тексты длиннее MAX_LEN обрезаются\n","        self.encodings = tokenizer(\n","            list(texts),\n","            truncation=True,\n","            padding='max_length',\n","            max_length=max_len,\n","            return_tensors='pt',\n","        )\n","        self.labels = torch.tensor(labels, dtype=torch.long)\n","\n","    def __len__(self):\n","        return len(self.labels)\n","\n","    def __getitem__(self, idx):\n","        return {\n","            'input_ids': self.encodings['input_ids'][idx],\n","            'attention_mask': self.encodings['attention_mask'][idx],\n","            'labels': self.labels[idx],\n","        }\n","\n","\n","train_dataset = SentimentDataset(X_train, y_train, tokenizer, MAX_LEN)\n","val_dataset = SentimentDataset(X_val,   y_val,   tokenizer, MAX_LEN)\n","test_dataset = SentimentDataset(X_test,  y_test,  tokenizer, MAX_LEN)\n","\n","# num_workers=2 два параллельных потока для загрузки батчей,\n","# снижает простой GPU в ожидании данных\n","train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True,  num_workers=4)\n","val_loader = DataLoader(val_dataset,   batch_size=BATCH_SIZE, shuffle=False, num_workers=4)\n","# shuffle=False для val и test - порядок не важен, зато результаты воспроизводимы\n","test_loader = DataLoader(test_dataset,  batch_size=BATCH_SIZE, shuffle=False, num_workers=4)\n","\n","print(f'Train batches: {len(train_loader)} | Val batches: {len(val_loader)}')"]},{"cell_type":"markdown","id":"14b27f2f","metadata":{"papermill":{"duration":0.054243,"end_time":"2026-05-19T21:21:06.335331+00:00","exception":false,"start_time":"2026-05-19T21:21:06.281088+00:00","status":"completed"},"tags":[]},"source":["## Модель и оптимизатор"]},{"cell_type":"markdown","id":"61db4c09","metadata":{"papermill":{"duration":0.054489,"end_time":"2026-05-19T21:21:06.44365+00:00","exception":false,"start_time":"2026-05-19T21:21:06.389161+00:00","status":"completed"},"tags":[]},"source":["### Обоснование выбора модели\n","\n","Для классификации тональности выбрана модель cointegrated/rubert-tiny2 \n","с дообучением (fine-tuning) на задачу классификации.\n","\n","Рассмотренные альтернативы:\n","\n","**TF-IDF + Logistic Regression** - используется как baseline. \n","Достоинства: мгновенное обучение, полная интерпретируемость. \n","Недостатки: не учитывает контекст и порядок слов, не понимает \n","отрицания (\"не понравилось\" ≠ \"понравилось\"), слабее на сложных случаях.\n","\n","**cointegrated/rubert-tiny (12M параметров)** - более лёгкая версия, \n","время обучения 20-30 минут на эпоху на CPU. Однако при наличии GPU \n","выигрыш в скорости становится несущественным (эпоха занимает 2-3 мин \n","против 5 мин у rubert-tiny2), при этом качество заметно ниже.\n","\n","**rubert-base-cased (180M параметров)** - наилучшее качество \n","для русскоязычных задач, однако требует значительно больше памяти GPU \n","и времени обучения (20-30 мин на эпоху на GPU), что нецелесообразно \n","при достаточном качестве более лёгкой модели.\n","\n","**multilingual-e5, XLM-RoBERTa** - мультиязычные модели уступают \n","монолингвальным русскоязычным моделям на русских текстах при \n","сопоставимом размере.\n","\n","**cointegrated/rubert-tiny2 выбран по следующим причинам:**\n","- 29M параметров - оптимальный баланс качество/скорость: \n","  при обучении на GPU эпоха занимает 5 минут, что делает \n","  полный цикл из 5 эпох практичным (25 минут)\n","- Обучен на русскоязычных текстах - понимает морфологию русского языка,\n","  контекст и отрицания лучше чем мультиязычные модели аналогичного размера\n","- Превосходит rubert-tiny по качеству при несущественной разнице \n","  в скорости обучения на GPU"]},{"cell_type":"markdown","id":"c7255dc0","metadata":{"papermill":{"duration":0.05424,"end_time":"2026-05-19T21:21:06.553027+00:00","exception":false,"start_time":"2026-05-19T21:21:06.498787+00:00","status":"completed"},"tags":[]},"source":["### Обоснование функции потерь\n","\n","Выбрана CrossEntropyLoss с весами классов (class_weight).\n","\n","CrossEntropyLoss - стандартная функция потерь для задач многоклассовой \n","классификации. Она оптимизирует логарифмическое правдоподобие \n","предсказанного распределения вероятностей по классам относительно \n","истинной метки.\n","\n","Взвешивание классов применяется для компенсации дисбаланса между \n","Neutral, Positive и Negative: веса обратно пропорциональны частоте \n","класса в обучающей выборке. Без взвешивания модель склонна \n","предсказывать доминирующий класс в ущерб редким.\n","\n","Альтернативой мог бы служить Focal Loss, который дополнительно \n","снижает вес лёгких примеров и фокусирует обучение на трудных случаях, \n","однако требует дополнительной настройки гиперпараметра gamma \n","и в базовом сценарии не даёт значимого преимущества перед \n","взвешенной CrossEntropy."]},{"cell_type":"markdown","id":"977db7f3","metadata":{"papermill":{"duration":0.053714,"end_time":"2026-05-19T21:21:06.661488+00:00","exception":false,"start_time":"2026-05-19T21:21:06.607774+00:00","status":"completed"},"tags":[]},"source":["### Обоснование метрики качества\n","\n","Основная метрика - F1 macro.\n","\n","F1 macro вычисляет F1-меру отдельно для каждого из трёх классов \n","(Neutral, Positive, Negative) и усредняет без учёта размера классов. \n","Это означает что все три класса вносят равный вклад в итоговую метрику, \n","что важно при наличии дисбаланса между классами.\n","\n","Дополнительные метрики:\n","- Accuracy - понятна для интерпретации, но вводит в заблуждение \n","  при дисбалансе классов (модель предсказывающая всегда Neutral \n","  может иметь высокую accuracy)\n","- ROC-AUC (One-vs-Rest, macro) - оценивает разделяющую способность \n","  модели независимо от порога классификации, хорошо дополняет F1\n","\n","Precision и Recall по каждому классу отдельно приводятся \n","в classification_report для детального анализа ошибок."]},{"cell_type":"markdown","id":"9c4718ae","metadata":{"papermill":{"duration":0.054638,"end_time":"2026-05-19T21:21:06.77011+00:00","exception":false,"start_time":"2026-05-19T21:21:06.715472+00:00","status":"completed"},"tags":[]},"source":["### Обоснование гиперпараметров\n","\n","- MAX_LEN=128: покрывает 95-й перцентиль длин текстов после токенизации\n","  на данном датасете. Значение 64 было бы быстрее, однако при наличии GPU \n","  разница в скорости несущественна, а покрытие длинных текстов улучшает \n","  качество классификации.\n","\n","- BATCH_SIZE=32: больший батч -> меньше шагов оптимизатора -> быстрее эпоха;\n","  разумный компромисс между скоростью и стабильностью градиентов,\n","  хорошо помещается в память GPU.\n","\n","- LR=2e-5: рекомендованный диапазон для fine-tuning BERT (1e-5 - 5e-5);\n","  слишком высокий LR разрушает предобученные веса (catastrophic forgetting),\n","  слишком низкий - медленная сходимость.\n","\n","- EPOCHS=5: при наличии GPU 5 эпох (~25 минут суммарно) позволяют \n","  модели полностью сойтись на данном датасете. Лучшая модель сохраняется \n","  по метрике val F1 (early stopping по валидации), что защищает \n","  от переобучения если оптимум достигается раньше 5-й эпохи.\n","\n","- WARMUP_RATIO=0.1: первые 10% шагов LR линейно растёт от 0 до целевого \n","  значения - стабилизирует начало обучения когда веса ещё не адаптированы \n","  к задаче.\n","\n","- WEIGHT_DECAY=0.01: L2-регуляризация через AdamW предотвращает \n","  переобучение на больших предобученных моделях."]},{"cell_type":"code","execution_count":31,"id":"3a4546a3","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:21:06.880158Z","iopub.status.busy":"2026-05-19T21:21:06.879413Z","iopub.status.idle":"2026-05-19T21:21:11.450119Z","shell.execute_reply":"2026-05-19T21:21:11.449086Z"},"papermill":{"duration":4.62856,"end_time":"2026-05-19T21:21:11.452852+00:00","exception":false,"start_time":"2026-05-19T21:21:06.824292+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"abcd3a993a28467ab486348a10cd2b1a","version_major":2,"version_minor":0},"text/plain":["model.safetensors:   0%|          | 0.00/118M [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"ced64ac6c02b4f029f51a5934b06fbd8","version_major":2,"version_minor":0},"text/plain":["Loading weights:   0%|          | 0/55 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stderr","output_type":"stream","text":["BertForSequenceClassification LOAD REPORT from: cointegrated/rubert-tiny2\n","Key                                        | Status     | \n","-------------------------------------------+------------+-\n","cls.predictions.transform.dense.weight     | UNEXPECTED | \n","cls.predictions.transform.LayerNorm.weight | UNEXPECTED | \n","cls.predictions.bias                       | UNEXPECTED | \n","cls.predictions.transform.dense.bias       | UNEXPECTED | \n","cls.seq_relationship.bias                  | UNEXPECTED | \n","cls.seq_relationship.weight                | UNEXPECTED | \n","bert.embeddings.position_ids               | UNEXPECTED | \n","cls.predictions.transform.LayerNorm.bias   | UNEXPECTED | \n","classifier.bias                            | MISSING    | \n","classifier.weight                          | MISSING    | \n","\n","Notes:\n","- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","- MISSING\t:those params were newly initialized because missing from the checkpoint. Consider training on your downstream task.\n"]},{"name":"stdout","output_type":"stream","text":["Параметры модели: 29,194,707\n","Веса классов: [1.222 0.647 1.13 ]\n"]}],"source":["from torch.nn import DataParallel\n","\n","EPOCHS = 5\n","LR = 2e-5\n","WARMUP_RATIO = 0.1\n","WEIGHT_DECAY = 0.01\n","\n","model = AutoModelForSequenceClassification.from_pretrained(\n","    MODEL_NAME,\n","    num_labels=NUM_LABELS,\n","    ignore_mismatched_sizes=True,\n",").to(DEVICE)\n","\n","model = DataParallel(model)\n","\n","# Взвешенная CrossEntropy для компенсации дисбаланса между 3 классами\n","class_counts  = np.bincount(y_train, minlength=NUM_LABELS)\n","class_weights = torch.tensor(\n","    [1.0 / c for c in class_counts], dtype=torch.float\n",").to(DEVICE)\n","class_weights = class_weights / class_weights.sum() * NUM_LABELS\n","criterion = torch.nn.CrossEntropyLoss(weight=class_weights)\n","\n","optimizer = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n","\n","total_steps = len(train_loader) * EPOCHS\n","warmup_steps = int(total_steps * WARMUP_RATIO)\n","# LR scheduler с линейным warmup. Первые 10% шагов LR растёт от 0 до целевого,\n","# затем линейно убывает до 0. Warmup стабилизирует начало обучения\n","# когда веса ещё не адаптированы к задаче\n","scheduler = get_linear_schedule_with_warmup(\n","    optimizer,\n","    num_warmup_steps=warmup_steps,\n","    num_training_steps=total_steps,\n",")\n","\n","print(f'Параметры модели: {sum(p.numel() for p in model.parameters()):,}')\n","print(f'Веса классов: {class_weights.cpu().numpy().round(3)}')"]},{"cell_type":"markdown","id":"a5a8e527","metadata":{"papermill":{"duration":0.059628,"end_time":"2026-05-19T21:21:11.578994+00:00","exception":false,"start_time":"2026-05-19T21:21:11.519366+00:00","status":"completed"},"tags":[]},"source":["## Функции обучения и оценки"]},{"cell_type":"code","execution_count":32,"id":"866534d7","metadata":{"execution":{"iopub.execute_input":"2026-05-19T21:21:11.707757Z","iopub.status.busy":"2026-05-19T21:21:11.707119Z","iopub.status.idle":"2026-05-19T21:21:11.718283Z","shell.execute_reply":"2026-05-19T21:21:11.717589Z"},"papermill":{"duration":0.077369,"end_time":"2026-05-19T21:21:11.719728+00:00","exception":false,"start_time":"2026-05-19T21:21:11.642359+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def train_epoch(model, loader, optimizer, scheduler, criterion, device):\n","    model.train()\n","    total_loss, total_correct, n = 0, 0, 0\n","    \n","    # Создаём прогресс-бар для батчей\n","    progress_bar = tqdm(loader, desc='Training', leave=False, unit='batch')\n","    \n","    for batch_idx, batch in enumerate(progress_bar):\n","        input_ids = batch['input_ids'].to(device)\n","        attention_mask = batch['attention_mask'].to(device)\n","        labels = batch['labels'].to(device)\n","\n","        optimizer.zero_grad()\n","        outputs = model(input_ids=input_ids, attention_mask=attention_mask)\n","        loss    = criterion(outputs.logits, labels)\n","        loss.backward()\n","\n","        # Gradient clipping - ограничиваем норму градиентов для\n","        # стабилизации обучения трансформеров (предотвращает взрыв градиентов)\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n","        optimizer.step()\n","        scheduler.step()   # обновляем learning rate по расписанию\n","\n","        batch_size = labels.size(0)\n","        total_loss += loss.item() * batch_size\n","        total_correct += (outputs.logits.argmax(-1) == labels).sum().item()\n","        n += batch_size\n","        \n","        # Обновляем прогресс-бар с текущими метриками\n","        current_loss = total_loss / n\n","        current_acc = total_correct / n\n","        progress_bar.set_postfix({\n","            'loss': f'{current_loss:.4f}',\n","            'acc': f'{current_acc:.4f}'\n","        })\n","    \n","    return total_loss / n, total_correct / n\n","\n","\n","@torch.no_grad()\n","def evaluate(model, loader, criterion, device):\n","    \"\"\"\n","    Оценка модели на val/test без обновления весов.\n","    @torch.no_grad() отключает вычисление градиентов\n","    это ускоряет инференс и снижает потребление памяти.\n","    \"\"\"\n","    model.eval()\n","    total_loss = 0\n","    all_preds, all_labels, all_probs = [], [], []\n","    \n","    # Создаём прогресс-бар для валидации\n","    progress_bar = tqdm(loader, desc='Validating', leave=False, unit='batch')\n","    \n","    for batch in progress_bar:\n","        input_ids = batch['input_ids'].to(device)\n","        attention_mask = batch['attention_mask'].to(device)\n","        labels = batch['labels'].to(device)\n","\n","        outputs = model(input_ids=input_ids, attention_mask=attention_mask)\n","        loss = criterion(outputs.logits, labels)\n","        \n","        batch_size = labels.size(0)\n","        total_loss += loss.item() * batch_size\n","\n","        # Вероятности по всем 3 классам для ROC-AUC OvR\n","        probs = torch.softmax(outputs.logits, dim=-1)\n","        all_preds.extend(probs.argmax(-1).cpu().numpy())\n","        all_labels.extend(labels.cpu().numpy())\n","        all_probs.extend(probs.cpu().numpy())   # shape: (n, 3)\n","        \n","        # Обновляем прогресс-бар с текущим loss\n","        current_loss = total_loss / len(all_labels)\n","        progress_bar.set_postfix({'loss': f'{current_loss:.4f}'})\n","\n","    n = len(all_labels)\n","    all_probs = np.array(all_probs)\n","\n","    return {\n","        'loss': total_loss / n,\n","        'accuracy': accuracy_score(all_labels, all_preds),\n","        'f1_macro': f1_score(all_labels, all_preds, average='macro'),\n","        'roc_auc': roc_auc_score(all_labels, all_probs,\n","                                   multi_class='ovr', average='macro'),\n","        'preds': all_preds,\n","        'labels': all_labels,\n","        'probs': all_probs,\n","    }"]},{"cell_type":"markdown","id":"e429c8db","metadata":{"papermill":{"duration":0.056401,"end_time":"2026-05-19T21:21:11.831652+00:00","