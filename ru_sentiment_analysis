.subplots(nrows, ncols, figsize=(18, 5 * nrows))\naxes = axes.flatten()\n\nfor i in range(N_TOPICS):\n    topic_terms = dict(lda_model.show_topic(i, topn=40))\n    wc = WordCloud(width=400, height=250,\n                   background_color='white').generate_from_frequencies(topic_terms)\n    axes[i].imshow(wc, interpolation='bilinear')\n    axes[i].axis('off')\n    axes[i].set_title(f'Тема {i+1}', fontweight='bold')\n\nfor j in range(N_TOPICS, len(axes)):\n    axes[j].axis('off')\n\nplt.suptitle('Облака слов по темам (LDA)', fontsize=15, fontweight='bold')\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-15T23:17:45.385208Z","iopub.execute_input":"2026-05-15T23:17:45.385544Z","iopub.status.idle":"2026-05-15T23:17:47.284267Z","shell.execute_reply.started":"2026-05-15T23:17:45.385513Z","shell.execute_reply":"2026-05-15T23:17:47.283223Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2160x1800 with 9 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":26},{"cell_type":"code","source":"# Heatmap: топ-слова по темам\nN_WORDS = 10\ntop_words_per_topic, topic_word_matrix = [], []\n\nfor i in range(N_TOPICS):\n    terms = lda_model.show_topic(i, topn=N_WORDS)\n    top_words_per_topic.append([w for w, _ in terms])\n    topic_word_matrix.append([v for _, v in terms])\n\ndf_heatmap = pd.DataFrame(\n    topic_word_matrix,\n    index=[f'Тема {i+1}' for i in range(N_TOPICS)],\n    columns=[f'Слово {j+1}' for j in range(N_WORDS)],\n)\n\nfig, ax = plt.subplots(figsize=(14, max(4, N_TOPICS * 0.6 + 2)))\nsns.heatmap(df_heatmap, annot=np.array(top_words_per_topic), fmt='',\n            cmap='YlOrRd', linewidths=0.5, ax=ax,\n            cbar_kws={'label': 'Вес слова в теме'})\nax.set_title('Топ-слова по темам LDA', fontsize=14, fontweight='bold')\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-15T23:17:47.285601Z","iopub.execute_input":"2026-05-15T23:17:47.285988Z","iopub.status.idle":"2026-05-15T23:17:47.693001Z","shell.execute_reply.started":"2026-05-15T23:17:47.285954Z","shell.execute_reply":"2026-05-15T23:17:47.692358Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1680x744 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":27},{"cell_type":"code","source":"# Распределение доминирующих тем по классам \ndominant_topics = []\nfor bow in bow_corpus:\n    topic_dist = lda_model.get_document_topics(bow, minimum_probability=0)\n    dominant_topics.append(max(topic_dist, key=lambda x: x[1])[0])\n\ndf_full['dominant_topic']       = dominant_topics\ndf_full['dominant_topic_label'] = df_full['dominant_topic'].apply(lambda x: f'Тема {x+1}')\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 5))\n\ndf_full['dominant_topic_label'].value_counts().sort_index().plot(\n    kind='bar', ax=axes[0], color='steelblue', edgecolor='black')\naxes[0].set_title('Распределение доминирующих тем')\naxes[0].set_xlabel('Тема')\naxes[0].set_ylabel('Документов')\naxes[0].tick_params(axis='x', rotation=45)\n\npivot = df_full.groupby(['dominant_topic_label', 'label_name']).size().unstack(fill_value=0)\npivot = pivot.reindex(columns=CLASS_NAMES)\npivot.plot(kind='bar', ax=axes[1],\n           color=[COLORS[c] for c in CLASS_NAMES], edgecolor='black')\naxes[1].set_title('Темы в разрезе тональности (3 класса)')\naxes[1].set_xlabel('Тема')\naxes[1].tick_params(axis='x', rotation=45)\naxes[1].legend(title='Тональность')\n\nplt.suptitle('Тематическая структура корпуса', fontsize=13, fontweight='bold')\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-15T23:17:47.694129Z","iopub.execute_input":"2026-05-15T23:17:47.694582Z","iopub.status.idle":"2026-05-15T23:18:32.103676Z","shell.execute_reply.started":"2026-05-15T23:17:47.694557Z","shell.execute_reply":"2026-05-15T23:18:32.102995Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1920x600 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":28},{"cell_type":"markdown","source":"### Предложения по улучшению тематического моделирования\n\n1. Лемматизация через pymorphy2 или natasha.\n   Сейчас токенизация не приводит слова к нормальной форме - \"врач\", \"врача\", \n   \"врачу\" считаются разными токенами и засоряют темы. Лемматизация объединит \n   их в одну форму, уменьшит словарь и повысит качество тем.\n\n2. Добавление биграмм и триграмм через gensim.Phrases.\n   Словосочетания \"быстрая доставка\", \"плохой сервис\", \"чистый номер\" \n   несут значительно больше смысла чем отдельные слова. \n   Автоматическое обнаружение устойчивых сочетаний улучшит интерпретируемость тем.\n\n3. Раздельное тематическое моделирование по классам тональности.\n   Обучение отдельных LDA-моделей для Positive, Negative и Neutral текстов \n   позволит выявить класс-специфичные темы: например, что именно хвалят \n   в позитивных отзывах и на что жалуются в негативных.\n\n4. Тонкая настройка гиперпараметров alpha и eta.\n   Текущие значения alpha='auto' и eta='auto' - это эвристика Gensim. \n   Grid search по сетке значений с оценкой через Coherence Score \n   может дать более качественные темы.\n\n5. Фильтрация тематически шумных документов.\n   Документы с равномерным распределением вероятностей по всем темам \n   (высокая энтропия распределения) не несут чёткой тематики и могут \n   ухудшать качество модели. Их фильтрация перед обучением потенциально \n   улучшит coherence.\n\n6. Повторная попытка с BERTopic на более мощной модели эмбеддингов.\n   Использование rubert-base-cased вместо rubert-tiny в связке \n   с подобранными параметрами HDBSCAN (min_cluster_size=500, \n   cluster_selection_method='leaf') может дать более качественное \n   разбиение на темы с учётом семантического контекста.\n\n7. Иерархическое тематическое моделирование.\n   BERTopic и специальные расширения LDA поддерживают построение \n   иерархии тем: сначала крупные категории (медицина, гостиницы, \n   транспорт), затем подтемы внутри каждой.","metadata":{}},{"cell_type":"markdown","source":"# Часть 2. Обучение классификатора","metadata":{}},{"cell_type":"markdown","source":"## Разбивка данных","metadata":{}},{"cell_type":"markdown","source":"### Обоснование разбивки данных\n\nДанные разбиты на три части в соотношении 70% / 15% / 15%\n(train / val / test) с помощью стратифицированного разбиения.\n\nГотовое разбиение от авторов датасета не использовалось по следующей \nпричине: датасет содержит только два сплита - train и validation - \nбез выделенного тестового набора. Использование validation в качестве \nтеста некорректно, так как на нём производится подбор лучшей эпохи \nв процессе обучения (сохранение модели по максимуму val F1), \nчто приводит к утечке данных и завышению итоговых метрик.\n\nПоэтому данные объединены и разбиты заново через sklearn.train_test_split\nс параметром stratify=label, что гарантирует сохранение пропорций \nклассов (Neutral / Positive / Negative) в каждом из трёх сплитов.\n\nВыбор соотношения 70/15/15:\n- 70% на обучение - достаточно для fine-tuning BERT на датасете \n  размером ~210k текстов (147k примеров в train)\n- 15% на валидацию - используется в процессе обучения для выбора \n  лучшей эпохи по метрике val F1 (31k примеров)\n- 15% на тест - не участвует в обучении и подборе гиперпараметров,\n  используется исключительно для финальной оценки качества (31k примеров)\n\nФиксация random_state=42 обеспечивает воспроизводимость разбиения.","metadata":{}},{"cell_type":"code","source":"# Разбивка данных\n# Стратифицированное разбиение 70/15/15 сохраняет пропорции\n# всех трёх классов в каждом сплите\ntrain_df, temp_df = train_test_split(df_full, test_size=0.30,\n                                      random_state=SEED, stratify=df_full['label'])\n# Из оставшихся 30% делаем val и test поровну\nval_df, test_df = train_test_split(temp_df, test_size=0.50,\n                                      random_state=SEED, stratify=temp_df['label'])\n\nX_train, y_train = train_df['text'].values, train_df['label'].values\nX_val, y_val = val_df['text'].values, val_df['label'].values\nX_test, y_test = test_df['text'].values, test_df['label'].values\n\nprint(f'Train: {len(X_train)} | Val: {len(X_val)} | Test: {len(X_test)}')\nprint(f'Train распределение: {np.bincount(y_train)}')\nprint(f'Val   распределение: {np.bincount(y_val)}')\nprint(f'Test  распределение: {np.bincount(y_test)}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T20:38:23.474463Z","iopub.execute_input":"2026-05-17T20:38:23.474811Z","iopub.status.idle":"2026-05-17T20:38:23.672648Z","shell.execute_reply.started":"2026-05-17T20:38:23.474784Z","shell.execute_reply":"2026-05-17T20:38:23.671904Z"}},"outputs":[{"name":"stdout","text":"Train: 138910 | Val: 29766 | Test: 29767\nTrain распределение: [34992 66067 37851]\nVal   распределение: [ 7498 14157  8111]\nTest  распределение: [ 7499 14157  8111]\n","output_type":"stream"}],"execution_count":17},{"cell_type":"markdown","source":"## Бейзлайн\nTFIDF + LogisticRegression","metadata":{}},{"cell_type":"code","source":"tfidf = TfidfVectorizer(max_features=30_000, ngram_range=(1, 2), min_df=2)\nX_train_tfidf = tfidf.fit_transform(X_train)\nX_val_tfidf = tfidf.transform(X_val)\nX_test_tfidf = tfidf.transform(X_test)\n\nlr = LogisticRegression(C=1.0, max_iter=500,\n                        class_weight='balanced',\n                        multi_class='multinomial',\n                        random_state=SEED)\nlr.fit(X_train_tfidf, y_train)\n\ny_pred_lr = lr.predict(X_test_tfidf)\nlr_probs = lr.predict_proba(X_test_tfidf)\n\nbaseline_acc = accuracy_score(y_test, y_pred_lr)\nbaseline_f1 = f1_score(y_test, y_pred_lr, average='macro')\nbaseline_auc = roc_auc_score(y_test, lr_probs, multi_class='ovr', average='macro')\n\nprint(f'Baseline Accuracy: {baseline_acc:.4f}')\nprint(f'Baseline F1 macro: {baseline_f1:.4f}')\nprint(f'Baseline ROC-AUC:  {baseline_auc:.4f}')\nprint(classification_report(y_test, y_pred_lr, target_names=CLASS_NAMES))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T20:38:23.673617Z","iopub.execute_input":"2026-05-17T20:38:23.673958Z","iopub.status.idle":"2026-05-17T20:40:01.823507Z","shell.execute_reply.started":"2026-05-17T20:38:23.673932Z","shell.execute_reply":"2026-05-17T20:40:01.822476Z"}},"outputs":[{"name":"stdout","text":"Baseline Accuracy: 0.7566\nBaseline F1 macro: 0.7525\nBaseline ROC-AUC:  0.9158\n              precision    recall  f1-score   support\n\n     Neutral       0.60      0.78      0.68      7499\n    Positive       0.87      0.71      0.78     14157\n    Negative       0.78      0.81      0.79      8111\n\n    accuracy                           0.76     29767\n   macro avg       0.75      0.77      0.75     29767\nweighted avg       0.78      0.76      0.76     29767\n\n","output_type":"stream"}],"execution_count":18},{"cell_type":"markdown","source":"## Dataset и DataLoader","metadata":{}},{"cell_type":"code","source":"MODEL_NAME = 'cointegrated/rubert-tiny2'\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n\n# Подбор MAX_LEN по 95-му перцентилю длин токенов\nsample_lens = [len(tokenizer.encode(t, truncation=False)) for t in X_train[:1000]]\nprint(f'Длины токенов - медиана: {np.median(sample_lens):.0f}, '\n      f'95-й перцентиль: {np.percentile(sample_lens, 95):.0f}, '\n      f'макс: {max(sample_lens)}')\n\nMAX_LEN = 512\nBATCH_SIZE = 40\n\n\nclass SentimentDataset(Dataset):\n    \"\"\"Dataset для 3-классовой классификации тональности.\n       Токенизирует все тексты сразу при инициализации (не на лету)\n       это ускоряет обучение за счёт отсутствия повторной токенизации на каждой эпохе\"\"\"\n\n    def __init__(self, texts, labels, tokenizer, max_len):\n        # padding='max_length' - все тексты дополняются до MAX_LEN\n        # truncation=True - тексты длиннее MAX_LEN обрезаются\n        self.encodings = tokenizer(\n            list(texts),\n            truncation=True,\n            padding='max_length',\n            max_length=max_len,\n            return_tensors='pt',\n        )\n        self.labels = torch.tensor(labels, dtype=torch.long)\n\n    def __len__(self):\n        return len(self.labels)\n\n    def __getitem__(self, idx):\n        return {\n            'input_ids': self.encodings['input_ids'][idx],\n            'attention_mask': self.encodings['attention_mask'][idx],\n            'labels': self.labels[idx],\n        }\n\n\ntrain_dataset = SentimentDataset(X_train, y_train, tokenizer, MAX_LEN)\nval_dataset = SentimentDataset(X_val,   y_val,   tokenizer, MAX_LEN)\ntest_dataset = SentimentDataset(X_test,  y_test,  tokenizer, MAX_LEN)\n\n# num_workers=2 два параллельных потока для загрузки батчей,\n# снижает простой GPU в ожидании данных\ntrain_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True,  num_workers=4)\nval_loader = DataLoader(val_dataset,   batch_size=BATCH_SIZE, shuffle=False, num_workers=4)\n# shuffle=False для val и test - порядок не важен, зато результаты воспроизводимы\ntest_loader = DataLoader(test_dataset,  batch_size=BATCH_SIZE, shuffle=False, num_workers=4)\n\nprint(f'Train batches: {len(train_loader)} | Val batches: {len(val_loader)}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T20:44:21.499696Z","iopub.execute_input":"2026-05-17T20:44:21.500180Z","iopub.status.idle":"2026-05-17T20:46:37.582974Z","shell.execute_reply.started":"2026-05-17T20:44:21.500148Z","shell.execute_reply":"2026-05-17T20:46:37.582163Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/693 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4540140955214d949c7b0488a5ca4476"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/401 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"6494cce7bce64a4e94e4007faa4d1e8f"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.txt: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0398902171d94da3b4a039f6385474de"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3e1b7ad9c8094f64967ce6139da30061"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"special_tokens_map.json:   0%|          | 0.00/112 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"fa947d4520ac4a23985ee9b916a05f08"}},"metadata":{}},{"name":"stdout","text":"Длины токенов - медиана: 110, 95-й перцентиль: 469, макс: 1026\nTrain batches: 3473 | Val batches: 745\n","output_type":"stream"}],"execution_count":19},{"cell_type":"markdown","source":"## Модель и оптимизатор","metadata":{}},{"cell_type":"markdown","source":"### Обоснование выбора модели\n\nДля классификации тональности выбрана модель cointegrated/rubert-tiny2 \nс дообучением (fine-tuning) на задачу классификации.\n\nРассмотренные альтернативы:\n\n**TF-IDF + Logistic Regression** - используется как baseline. \nДостоинства: мгновенное обучение, полная интерпретируемость. \nНедостатки: не учитывает контекст и порядок слов, не понимает \nотрицания (\"не понравилось\" ≠ \"понравилось\"), слабее на сложных случаях.\n\n**cointegrated/rubert-tiny (12M параметров)** - более лёгкая версия, \nвремя обучения 20-30 минут на эпоху на CPU. Однако при наличии GPU \nвыигрыш в скорости становится несущественным (эпоха занимает 2-3 мин \nпротив 5 мин у rubert-tiny2), при этом качество заметно ниже.\n\n**rubert-base-cased (180M параметров)** - наилучшее качество \nдля русскоязычных задач, однако требует значительно больше памяти GPU \nи времени обучения (20-30 мин на эпоху на GPU), что нецелесообразно \nпри достаточном качестве более лёгкой модели.\n\n**multilingual-e5, XLM-RoBERTa** - мультиязычные модели уступают \nмонолингвальным русскоязычным моделям на русских текстах при \nсопоставимом размере.\n\n**cointegrated/rubert-tiny2 выбран по следующим причинам:**\n- 29M параметров - оптимальный баланс качество/скорость: \n  при обучении на GPU эпоха занимает 5 минут, что делает \n  полный цикл из 5 эпох практичным (25 минут)\n- Обучен на русскоязычных текстах - понимает морфологию русского языка,\n  контекст и отрицания лучше чем мультиязычные модели аналогичного размера\n- Превосходит rubert-tiny по качеству при несущественной разнице \n  в скорости обучения на GPU","metadata":{}},{"cell_type":"markdown","source":"### Обоснование функции потерь\n\nВыбрана CrossEntropyLoss с весами классов (class_weight).\n\nCrossEntropyLoss - стандартная функция потерь для задач многоклассовой \nклассификации. Она оптимизирует логарифмическое правдоподобие \nпредсказанного распределения вероятностей по классам относительно \nистинной метки.\n\nВзвешивание классов применяется для компенсации дисбаланса между \nNeutral, Positive и Negative: веса обратно пропорциональны частоте \nкласса в обучающей выборке. Без взвешивания модель склонна \nпредсказывать доминирующий класс в ущерб редким.\n\nАльтернативой мог бы служить Focal Loss, который дополнительно \nснижает вес лёгких примеров и фокусирует обучение на трудных случаях, \nоднако требует дополнительной настройки гиперпараметра gamma \nи в базовом сценарии не даёт значимого преимущества перед \nвзвешенной CrossEntropy.","metadata":{}},{"cell_type":"markdown","source":"### Обоснование метрики качества\n\nОсновная метрика - F1 macro.\n\nF1 macro вычисляет F1-меру отдельно для каждого из трёх классов \n(Neutral, Positive, Negative) и усредняет без учёта размера классов. \nЭто означает что все три класса вносят равный вклад в итоговую метрику, \nчто важно при наличии дисбаланса между классами.\n\nДополнительные метрики:\n- Accuracy - понятна для интерпретации, но вводит в заблуждение \n  при дисбалансе классов (модель предсказывающая всегда Neutral \n  может иметь высокую accuracy)\n- ROC-AUC (One-vs-Rest, macro) - оценивает разделяющую способность \n  модели независимо от порога классификации, хорошо дополняет F1\n\nPrecision и Recall по каждому классу отдельно приводятся \nв classification_report для детального анализа ошибок.","metadata":{}},{"cell_type":"markdown","source":"### Обоснование гиперпараметров\n\n- MAX_LEN=128: покрывает 95-й перцентиль длин текстов после токенизации\n  на данном датасете. Значение 64 было бы быстрее, однако при наличии GPU \n  разница в скорости несущественна, а покрытие длинных текстов улучшает \n  качество классификации.\n\n- BATCH_SIZE=32: больший батч -> меньше шагов оптимизатора -> быстрее эпоха;\n  разумный компромисс между скоростью и стабильностью градиентов,\n  хорошо помещается в память GPU.\n\n- LR=2e-5: рекомендованный диапазон для fine-tuning BERT (1e-5 - 5e-5);\n  слишком высокий LR разрушает предобученные веса (catastrophic forgetting),\n  слишком низкий - медленная сходимость.\n\n- EPOCHS=5: при наличии GPU 5 эпох (~25 минут суммарно) позволяют \n  модели полностью сойтись на данном датасете. Лучшая модель сохраняется \n  по метрике val F1 (early stopping по валидации), что защищает \n  от переобучения если оптимум достигается раньше 5-й эпохи.\n\n- WARMUP_RATIO=0.1: первые 10% шагов LR линейно растёт от 0 до целевого \n  значения - стабилизирует начало обучения когда веса ещё не адаптированы \n  к задаче.\n\n- WEIGHT_DECAY=0.01: L2-регуляризация через AdamW предотвращает \n  переобучение на больших предобученных моделях.","metadata":{}},{"cell_type":"code","source":"from torch.nn import DataParallel\n\nEPOCHS = 5\nLR = 2e-5\nWARMUP_RATIO = 0.1\nWEIGHT_DECAY = 0.01\n\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    MODEL_NAME,\n    num_labels=NUM_LABELS,\n    ignore_mismatched_sizes=True,\n).to(DEVICE)\n\nmodel = DataParallel(model)\n\n# Взвешенная CrossEntropy для компенсации дисбаланса между 3 классами\nclass_counts  = np.bincount(y_train, minlength=NUM_LABELS)\nclass_weights = torch.tensor(\n    [1.0 / c for c in class_counts], dtype=torch.float\n).to(DEVICE)\nclass_weights = class_weights / class_weights.sum() * NUM_LABELS\ncriterion = torch.nn.CrossEntropyLoss(weight=class_weights)\n\noptimizer = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n\ntotal_steps = len(train_loader) * EPOCHS\nwarmup_steps = int(total_steps * WARMUP_RATIO)\n# LR scheduler с линейным warmup. Первые 10% шагов LR растёт от 0 до целевого,\n# затем линейно убывает до 0. Warmup стабилизирует начало обучения\n# когда веса ещё не адаптированы к задаче\nscheduler = get_linear_schedule_with_warmup(\n    optimizer,\n    num_warmup_steps=warmup_steps,\n    num_training_steps=total_steps,\n)\n\nprint(f'Параметры модели: {sum(p.numel() for p in model.parameters()):,}')\nprint(f'Веса классов: {class_weights.cpu().numpy().round(3)}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T20:46:37.584306Z","iopub.execute_input":"2026-05-17T20:46:37.584667Z","iopub.status.idle":"2026-05-17T20:46:41.166821Z","shell.execute_reply.started":"2026-05-17T20:46:37.584641Z","shell.execute_reply":"2026-05-17T20:46:41.166106Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"model.safetensors:   0%|          | 0.00/118M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9cc379798b604b80b46b120b528e83b1"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/55 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"81bb8450971e440f97ec9acbd0bc4ee7"}},"metadata":{}},{"name":"stderr","text":"BertForSequenceClassification LOAD REPORT from: cointegrated/rubert-tiny2\nKey                                        | Status     | \n-------------------------------------------+------------+-\ncls.seq_relationship.bias                  | UNEXPECTED | \ncls.predictions.bias                       | UNEXPECTED | \ncls.seq_relationship.weight                | UNEXPECTED | \ncls.predictions.transform.LayerNorm.bias   | UNEXPECTED | \nbert.embeddings.position_ids               | UNEXPECTED | \ncls.predictions.transform.dense.bias       | UNEXPECTED | \ncls.predictions.transform.LayerNorm.weight | UNEXPECTED | \ncls.predictions.transform.dense.weight     | UNEXPECTED | \nclassifier.weight                          | MISSING    | \nclassifier.bias                            | MISSING    | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n- MISSING\t:those params were newly initialized because missing from the checkpoint. Consider training on your downstream task.\n","output_type":"stream"},{"name":"stdout","text":"Параметры модели: 29,194,707\nВеса классов: [1.222 0.647 1.13 ]\n","output_type":"stream"}],"execution_count":20},{"cell_type":"markdown","source":"## Функции обучения и оценки","metadata":{}},{"cell_type":"code","source":"def train_epoch(model, loader, optimizer, scheduler, criterion, device):\n    model.train()\n    total_loss, total_correct, n = 0, 0, 0\n    \n    # Создаём прогресс-бар для батчей\n    progress_bar = tqdm(loader, desc='Training', leave=False, unit='batch')\n    \n    for batch_idx, batch in enumerate(progress_bar):\n        input_ids = batch['input_ids'].to(device)\n        attention_mask = batch['attention_mask'].to(device)\n        labels = batch['labels'].to(device)\n\n        optimizer.zero_grad()\n        outputs = model(input_ids=input_ids, attention_mask=attention_mask)\n        loss    = criterion(outputs.logits, labels)\n        loss.backward()\n\n        # Gradient clipping - ограничиваем норму градиентов для\n        # стабилизации обучения трансформеров (предотвращает взрыв градиентов)\n        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n        optimizer.step()\n        scheduler.step()   # обновляем learning rate по расписанию\n\n        batch_size = labels.size(0)\n        total_loss += loss.item() * batch_size\n        total_correct += (outputs.logits.argmax(-1) == labels).sum().item()\n        n += batch_size\n        \n        # Обновляем прогресс-бар с текущими метриками\n        current_loss = total_loss / n\n        current_acc = total_correct / n\n        progress_bar.set_postfix({\n            'loss': f'{current_loss:.4f}',\n            'acc': f'{current_acc:.4f}'\n        })\n    \n    return total_loss / n, total_correct / n\n\n\n@torch.no_grad()\ndef evaluate(model, loader, criterion, device):\n    \"\"\"\n    Оценка модели на val/test без обновления весов.\n    @torch.no_grad() отключает вычисление градиентов\n    это ускоряет инференс и снижает потребление памяти.\n    \"\"\"\n    model.eval()\n    total_loss = 0\n    all_preds, all_labels, all_probs = [], [], []\n    \n    # Создаём прогресс-бар для валидации\n    progress_bar = tqdm(loader, desc='Validating', leave=False, unit='batch')\n    \n    for batch in progress_bar:\n        input_ids = batch['input_ids'].to(device)\n        attention_mask = batch['attention_mask'].to(device)\n        labels = batch['labels'].to(device)\n\n        outputs = model(input_ids=input_ids, attention_mask=attention_mask)\n        loss = criterion(outputs.logits, labels)\n        \n        batch_size = labels.size(0)\n        total_loss += loss.item() * batch_size\n\n        # Вероятности по всем 3 классам для ROC-AUC OvR\n        probs = torch.softmax(outputs.logits, dim=-1)\n        all_preds.extend(probs.argmax(-1).cpu().numpy())\n        all_labels.extend(labels.cpu().numpy())\n        all_probs.extend(probs.cpu().numpy())   # shape: (n, 3)\n        \n        # Обновляем прогресс-бар с текущим loss\n        current_loss = total_loss / len(all_labels)\n        progress_bar.set_postfix({'loss': f'{current_loss:.4f}'})\n\n    n = len(all_labels)\n    all_probs = np.array(all_probs)\n\n    return {\n        'loss': total_loss / n,\n        'accuracy': accuracy_score(all_labels, all_preds),\n        'f1_macro': f1_score(all_labels, all_preds, average='macro'),\n        'roc_auc': roc_auc_score(all_labels, all_probs,\n                                   multi_class='ovr', average='macro'),\n        'preds': all_preds,\n        'labels': all_labels,\n        'probs': all_probs,\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T20:47:44.163127Z","iopub.execute_input":"2026-05-17T20:47:44.163913Z","iopub.status.idle":"2026-05-17T20:47:44.175113Z","shell.execute_reply.started":"2026-05-17T20:47:44.163881Z","shell.execute_reply":"2026-05-17T20:47:44.174407Z"}},"outputs":[],"execution_count":22},{"cell_type":"markdown","source":"## Цикл обучения","metadata":{}},{"cell_type":"code","source":"history = {k: [] for k in ['train_loss', 'train_acc',\n                             'val_loss', 'val_acc', 'val_f1', 'val_auc']}\nbest_f1, best_model_path = 0, '/tmp/best_model.pt'\n\nprint(f'Обучение на {DEVICE} | Epochs={EPOCHS} | LR={LR} | num_labels={NUM_LABELS}')\nprint('─' * 75)\n\n# Создаём основной прогресс-бар для эпох\nmain_pbar = tqdm(range(1, EPOCHS + 1), desc='Epochs', unit='epoch', position=0)\n\nfor epoch in main_pbar:\n    t0 = time.time()\n\n    train_loss, train_acc = train_epoch(\n        model, train_loader, optimizer, scheduler, criterion, DEVICE)\n    val_metrics = evaluate(model, val_loader, criterion, DEVICE)\n\n    history['train_loss'].append(train_loss)\n    history['train_acc'].append(train_acc)\n    history['val_loss'].append(val_metrics['loss'])\n    history['val_acc'].append(val_metrics['accuracy'])\n    history['val_f1'].append(val_metrics['f1_macro'])\n    history['val_auc'].append(val_metrics['roc_auc'])\n\n    saved = ''\n    \n    # Сохраняем чекпоинт только если val F1 улучшился\n    # это защищает от переобучения если оптимум достигается раньше последней эпохи\n    if val_metrics['f1_macro'] > best_f1:\n        best_f1 = val_metrics['f1_macro']\n        torch.save(model.state_dict(), best_model_path)\n        saved = 'saved'\n\n    # Обновляем основной прогресс-бар\n    main_pbar.set_postfix({\n        'train_loss': f'{train_loss:.4f}',\n        'train_acc': f'{train_acc:.4f}',\n        'val_f1': f'{val_metrics[\"f1_macro\"]:.4f}'\n    })\n    \n    # Выводим детальную информацию \n    print(f\"\\nEpoch {epoch}/{EPOCHS} [{time.time()-t0:.0f}s] \"\n          f\"train_loss={train_loss:.4f} acc={train_acc:.4f} | \"\n          f\"val_loss={val_metrics['loss']:.4f} \"\n          f\"f1={val_metrics['f1_macro']:.4f} \"\n          f\"auc={val_metrics['roc_auc']:.4f} {saved}\\n\")\n\nprint('─' * 75)\nprint(f'Лучший val F1: {best_f1:.4f}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T20:47:50.742951Z","iopub.execute_input":"2026-05-17T20:47:50.743487Z","iopub.status.idle":"2026-05-17T21:40:32.287267Z","shell.execute_reply.started":"2026-05-17T20:47:50.743459Z","shell.execute_reply":"2026-05-17T21:40:32.285907Z"}},"outputs":[{"name":"stdout","text":"Обучение на cuda | Epochs=5 | LR=2e-05 | num_labels=3\n───────────────────────────────────────────────────────────────────────────\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Epochs:   0%|          | 0/5 [00:00<?, ?epoch/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"01ea17df17da47eab7b7cd370ce7b784"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Training:   0%|          | 0/3473 [00:00<?, ?batch/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Validating:   0%|          | 0/745 [00:00<?, ?batch/s]","application/vnd.jupyte