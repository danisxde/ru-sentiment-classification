stream"}],"execution_count":25},{"cell_type":"code","source":"# Матрица ошибок \nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\nfor ax, norm, fmt, title in [\n    (axes[0], None,    'd',   'Confusion Matrix (абс.)'),\n    (axes[1], 'true', '.2f', 'Confusion Matrix (норм.)'),\n]:\n    cm = confusion_matrix(test_metrics['labels'], test_metrics['preds'], normalize=norm)\n    ConfusionMatrixDisplay(cm, display_labels=CLASS_NAMES).plot(\n        ax=ax, colorbar=False, cmap='Blues', values_format=fmt)\n    ax.set_title(title, fontweight='bold')\n\nplt.suptitle('Анализ ошибок классификатора', fontsize=13, fontweight='bold')\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T22:03:20.360515Z","iopub.execute_input":"2026-05-17T22:03:20.361002Z","iopub.status.idle":"2026-05-17T22:03:20.623271Z","shell.execute_reply.started":"2026-05-17T22:03:20.360969Z","shell.execute_reply":"2026-05-17T22:03:20.622629Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1680x600 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":35},{"cell_type":"markdown","source":"## Скорость инференса: CPU vs GPU\nБенчмаркинг","metadata":{}},{"cell_type":"code","source":"N_WARMUP, N_MEASURE = 5, 30\nbench_batch = next(iter(test_loader))\n\n# Замер скорости. Сначала warmup прогоны чтобы прогреть кэши CPU/GPU,\n# затем N_MEASURE прогонов для стабильного среднего значения latency\ndef measure_speed(model, batch, device, n_warmup, n_measure):\n    \"\"\"Возвращает latency (ms/batch) и throughput (samples/sec).\"\"\"\n    model.eval().to(device)\n    inp = {k: v.to(device) for k, v in batch.items() if k != 'labels'}\n\n    with torch.no_grad():\n        for _ in range(n_warmup):\n            model(**inp)\n        # Синхронизация GPU перед замером времени\n        # без неё время будет замерено до завершения вычислений на GPU\n        if device.type == 'cuda':\n            torch.cuda.synchronize()\n        t0 = time.perf_counter()\n        for _ in range(n_measure):\n            model(**inp)\n        if device.type == 'cuda':\n            torch.cuda.synchronize()\n        elapsed = time.perf_counter() - t0\n\n    bs = batch['labels'].size(0)\n    lat = elapsed / n_measure * 1000\n    thr = bs * n_measure / elapsed\n    return lat, thr\n\n\ncpu_lat, cpu_thr = measure_speed(model, bench_batch, torch.device('cpu'), N_WARMUP, N_MEASURE)\nprint(f'CPU -> latency: {cpu_lat:.1f} ms/batch | throughput: {cpu_thr:.1f} samples/sec')\n\nif torch.cuda.is_available():\n    gpu_lat, gpu_thr = measure_speed(model, bench_batch, torch.device('cuda'), N_WARMUP, N_MEASURE)\n    print(f'GPU -> latency: {gpu_lat:.1f} ms/batch | throughput: {gpu_thr:.1f} samples/sec')\n    print(f'Ускорение GPU vs CPU: {cpu_lat/gpu_lat:.1f}x')\nelse:\n    gpu_lat, gpu_thr = None, None\n    print('GPU недоступен')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T07:01:31.263602Z","iopub.execute_input":"2026-05-16T07:01:31.263920Z","iopub.status.idle":"2026-05-16T07:01:37.667946Z","shell.execute_reply.started":"2026-05-16T07:01:31.263895Z","shell.execute_reply":"2026-05-16T07:01:37.667024Z"}},"outputs":[{"name":"stdout","text":"CPU -> latency: 152.6 ms/batch | throughput: 209.7 samples/sec\nGPU -> latency: 11.3 ms/batch | throughput: 2824.3 samples/sec\nУскорение GPU vs CPU: 13.5x\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"# Сводная таблица: baseline vs BERT \nsummary = pd.DataFrame([\n    {\n        'Модель': 'TF-IDF + LogReg (baseline)',\n        'Accuracy': round(baseline_acc, 4),\n        'F1 macro': round(baseline_f1,  4),\n        'ROC-AUC': round(baseline_auc, 4),\n    },\n    {\n        'Модель': 'rubert-tiny2 (fine-tuned)',\n        'Accuracy': round(test_metrics['accuracy'], 4),\n        'F1 macro': round(test_metrics['f1_macro'],  4),\n        'ROC-AUC': round(test_metrics['roc_auc'],   4),\n    },\n])\nprint(summary.to_string(index=False))\nsummary","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T22:05:48.651563Z","iopub.execute_input":"2026-05-17T22:05:48.652197Z","iopub.status.idle":"2026-05-17T22:05:48.671212Z","shell.execute_reply.started":"2026-05-17T22:05:48.652167Z","shell.execute_reply":"2026-05-17T22:05:48.670439Z"}},"outputs":[{"name":"stdout","text":"                    Модель  Accuracy  F1 macro  ROC-AUC\nTF-IDF + LogReg (baseline)    0.7566    0.7525   0.9158\n rubert-tiny2 (fine-tuned)    0.7979    0.7918   0.9399\n","output_type":"stream"},{"execution_count":37,"output_type":"execute_result","data":{"text/plain":"                       Модель  Accuracy  F1 macro  ROC-AUC\n0  TF-IDF + LogReg (baseline)    0.7566    0.7525   0.9158\n1   rubert-tiny2 (fine-tuned)    0.7979    0.7918   0.9399","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Модель</th>\n      <th>Accuracy</th>\n      <th>F1 macro</th>\n      <th>ROC-AUC</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>TF-IDF + LogReg (baseline)</td>\n      <td>0.7566</td>\n      <td>0.7525</td>\n      <td>0.9158</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>rubert-tiny2 (fine-tuned)</td>\n      <td>0.7979</td>\n      <td>0.7918</td>\n      <td>0.9399</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":37},{"cell_type":"markdown","source":"### Предложения по улучшению качества и скорости\n\n**Улучшение качества:**\n\n1. Domain Adaptive Pre-Training (DAPT).\n   Дообучение языковой модели на masked LM задаче на корпусе \n   тематически близких текстов (отзывы, социальные сети) перед \n   fine-tuning на классификацию. Позволяет модели адаптироваться \n   к специфической лексике домена и даёт прирост +1-3% F1.\n\n2. Аугментация данных.\n   Back-translation (ru -> en -> ru через OPUS-MT) и Easy Data \n   Augmentation (замена синонимами, случайная перестановка слов) \n   позволяют увеличить разнообразие обучающих примеров, \n   особенно полезно для недопредставленных классов.\n\n3. Ансамблирование.\n   Усреднение logits от нескольких моделей (rubert-tiny + rubert-tiny2) \n   стабильно даёт +0.5-1% F1 при незначительных дополнительных \n   затратах на обучение.\n\n4. Focal Loss.\n   Замена CrossEntropyLoss на Focal Loss фокусирует обучение \n   на трудных примерах и может улучшить качество на граничных случаях \n   (например, нейтральные тексты с лёгким позитивным оттенком).\n\n5. Pseudo-labeling.\n   Разметка дополнительного неразмеченного корпуса текущей моделью \n   с последующим дообучением на уверенных предсказаниях \n   (вероятность > 0.95).\n\n**Улучшение скорости:**\n\n1. Dynamic INT8 Quantization.\n   Квантизация линейных слоёв модели из FP32 в INT8 даёт \n   ускорение 2-4x на CPU при потере F1 менее 1%. \n   Реализуется одной строкой через torch.quantization.quantize_dynamic \n   без необходимости переобучения (реализовано в Части 3).\n\n2. Дистилляция знаний.\n   Обучение компактной модели (2-3 слоя) с использованием \n   rubert-tiny как учителя. Ожидаемое ускорение 4-8x при потере \n   2-3% F1. Требует дополнительного этапа обучения.\n\n3. Dynamic Batching.\n   Группировка текстов схожей длины в один батч снижает \n   overhead от padding на 20-30% и увеличивает эффективный \n   throughput без потери качества.\n\n4. torch.compile (PyTorch ≥ 2.0).\n   Компиляция графа вычислений даёт +10-30% ускорения \n   без каких-либо изменений архитектуры или качества модели.","metadata":{}},{"cell_type":"markdown","source":"# Часть 3.* Оптимизация классификатора","metadata":{}},{"cell_type":"markdown","source":"### Обоснование выбора метода оптимизации\n\nДля оптимизации инференса на CPU выбрана Dynamic INT8 Quantization \n(динамическая квантизация в формат INT8).\n\nРассмотренные альтернативы:\n\n**Static INT8 Quantization** - даёт чуть лучшее ускорение (3-5x), \nоднако требует калибровочного датасета для вычисления статистик \nактиваций, что усложняет пайплайн. Динамическая квантизация не требует \nкалибровки и применяется непосредственно к обученной модели.\n\n**ONNX Runtime + INT8** - потенциально даёт наилучшее ускорение (3-6x) \nи широко используется в проде, однако требует конвертации модели \nв ONNX формат и настройки отдельного рантайма, что увеличивает \nсложность развёртывания.\n\n**Pruning (прореживание весов)** - удаление незначимых весов модели. \nДаёт скромное ускорение (1.2-2x) при значительной сложности реализации \nи риске большей потери качества. Неструктурированный pruning практически \nне ускоряет инференс без специализированного железа.\n\n**Knowledge Distillation** - обучение компактной модели. \nДаёт наибольшее ускорение (4-8x), однако требует полноценного \nпереобучения новой модели, что выходит за рамки оптимизации \nсуществующей модели для инференса.\n\n**Dynamic INT8 Quantization выбрана по следующим причинам:**\n- Минимальная сложность реализации: применяется одной функцией \n  torch.quantization.quantize_dynamic без изменения архитектуры\n- Не требует калибровочного датасета или переобучения\n- Квантизация Linear-слоёв BERT - наиболее вычислительно затратных - \n  даёт ускорение 2-4x на CPU\n- Потеря качества как правило менее 1% F1, что приемлемо для прода\n- Уменьшение размера модели в 2-4 раза снижает требования к памяти","metadata":{}},{"cell_type":"code","source":"import torch.quantization\nimport os\nimport tempfile\n\nmodel_cpu = model.to('cpu').eval()\n\n\n# Квантизуем только Linear-слои — они наиболее вычислительно затратны в BERT\n# quantize_dynamic не требует калибровочного датасета — применяется напрямую\nmodel_int8 = torch.quantization.quantize_dynamic(\n    model_cpu,\n    {torch.nn.Linear},\n    dtype=torch.qint8,\