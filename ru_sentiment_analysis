                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   text label_name\n55430     08 ноября 2016, 20:18   forbes.kz   Костанай в этом году стал автомобильной столицей Казахстана. 60% валового автомобильного производства страны приходится на долю областного центра, передает корреспондент  .   «Костанайское предприятие первое перешло на мелкоузловое производство. По некоторым видам коммерческой техники рост локализации (использование автокомпонентов отечественного производства. Прим.ред.) дошел до 50 процентов, по легковым автомобилям до 35 процентов, и это не предел. В стране с момента ГПФИИР было произведено почти 630 тысяч автомобилей казахстанского производства на сумму 550 млрд тенге, создано более 17 тысяч рабочих мест в смежных отраслях. Мы добились того, что доля авто казахстанского производства сегодня уже составляет более 33 процентов», — сообщил глава Ассоциации казахстанского автобизнеса Андрей Лаврентьев во время визита первого вице-премьера Аскара Мамина в Костанайскую область.   Говоря в целом о состоянии казахстанского автопрома, Лаврентьев отметил, что рынок постепенно справляется с последствиями экономического кризиса и в августе удалось достигнуть уровня развития прошлых лет. Но подчеркнул, что населению нужен бюджетный автомобиль, такой как, например, узбекский Ravon (усовершенствованная Nexia). Его стоимость составляет в среднем 2 млн 200 тысяч тенге и такой цены удалось достичь благодаря высокой локализации автокомпонентов   — 90 процентов.   «Чтобы перейти к локализации, нам нужно рассмотреть два вопроса. Первый – это стимулирование внутреннего рынка, это поддержка по программе лизинга, по программе льготного кредитования, которой воспользовались более 40 процентов граждан, купивших в 2016 году автомобили. Второй вопрос – это обеспечение экспортного потенциала. Здесь наш главный партнер – Российская федерация. Также готовность делать серьезные вложения в казахстанский автопром в рамках совместного предприятия выразили китайцы с автомобильным брендом Jac», — добавил Лаврентьев.   Первый заместитель премьер-министра Аскар Мамин похвалил главу Ассоциации казахстанского автобизнеса за привлечение инвестиций в регион и пообещал поддержку.   «28 ноября запланирована встреча с китайской стороной, подготовьте ваши предложения, мы все это обговорим с китайскими коллегами», — дал поручение Аскар Мамин. Айжан Утевова   По сообщению сайта Костанай ТВ     Neutral\n145293                                                                                                                                                                                                             13 января 2017, 18:09   kapital.kz   В ходе пресс-конференции с представителями единного пенсионного фонда стало известно, что должность председателя АО «ЕНПФ» была избрана Нурбиби Наурызбаева, передает корреспондент  .   Решение было принято в результате единогласного решения Совета директоров, прошедшего сегодня в Алматы.   «На повестке дня стоял вопрос о назначении  председателя правления АО  «ЕНПФ». Сегодня  председателем  единогласно  была избрана  Нурбиби Наурызбаева. До настоящего времени она являлась директором департамента  внутреннего аудита Нацбанка, стаж в финансовой сфере составляет 33 года, она отличник финансовой службы», — проинформировала заместитель председателя правления  Национльного банка РК Дина Галиева.   В свою очередь, Нурбиби Наурызбаева отметила, что впредь деятельность фонда будет более прозрачной. Также она планирует создать общественный совет.   «В совет войдут  опытные  представители СМИ, эксперты в области  финансов, некоторые вкладчики фонда, получатели пенсии и общественные организации. Вторым важным этапом является прозрачность деятельности и постоянное информирование общественности», сказала новоизбранный председатель правления Нурбиби Наурызбаева.   Напомним, 9 января бывший председатель  правления Руслан Ерденаев и его заместитель  были  водворены в ИВС, а позже взяты под  стражу сроком  на два месяца. Днем 9 января стало известно, что постановлением Алмалинского районного суда г. Алматы в отношении подозреваемых